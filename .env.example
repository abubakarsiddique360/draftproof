# DraftProof configuration example.
# Copy to .env and adjust. Every value has a working default.

# --- Provider routing ---------------------------------------------------
DRAFTPROOF_PROVIDER=mock
# DRAFTPROOF_MODEL=
# DRAFTPROOF_FALLBACK_PROVIDERS=groq,openai
# DRAFTPROOF_BASE_URL=
# DRAFTPROOF_API_KEY=
# DRAFTPROOF_ANTHROPIC_API_KEY=
DRAFTPROOF_TEMPERATURE=0.25
DRAFTPROOF_MAX_TOKENS=3000
DRAFTPROOF_MAX_RETRIES=2
DRAFTPROOF_CONCURRENCY=4
DRAFTPROOF_SEED=7

# --- Run policy ---------------------------------------------------------
DRAFTPROOF_MAX_COST_USD=1.00
DRAFTPROOF_MAX_REVISION_ATTEMPTS=2
DRAFTPROOF_REVIEW_REQUIRED=false

# --- Research and verification -----------------------------------------
# local_corpus (offline, bundled) | tavily (web) | none (closed-book)
DRAFTPROOF_RETRIEVER=local_corpus
# DRAFTPROOF_TAVILY_API_KEY=
# DRAFTPROOF_VERIFICATION=auto
DRAFTPROOF_EVIDENCE_LIMIT=8
DRAFTPROOF_RESULTS_PER_QUERY=4
# DRAFTPROOF_ALLOWED_DOMAINS=
# DRAFTPROOF_BLOCKED_DOMAINS=

# --- HTTP service -------------------------------------------------------
# DRAFTPROOF_SERVICE_API_KEY=
DRAFTPROOF_RATE_LIMIT_PER_MINUTE=60
# DRAFTPROOF_CORS_ORIGINS=https://example.com

# --- Storage ------------------------------------------------------------
DRAFTPROOF_DATA_DIR=data
DRAFTPROOF_LOG_LEVEL=INFO
